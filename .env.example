# Copy this file to .env, then replace the two placeholders below.
#
#   Supabase dashboard -> Project Settings -> API Keys
#     EXPO_PUBLIC_SUPABASE_URL              Project URL
#     EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY  Publishable key (starts with sb_publishable_)
#
# Both are publishable values: EXPO_PUBLIC_* variables are compiled into the app
# bundle and are visible to anyone using the app. What they can actually read or
# write is decided by the row level security policies in supabase/migrations.
#
# Never put the database password or a secret (sb_secret_*) key here — those
# bypass row level security.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>

# Optional: self-hosted Photon geocoder for map search. Defaults to the public
# photon.komoot.io instance, which is fine for development only.
# EXPO_PUBLIC_GEOCODER_URL=https://photon.example.org/api

# Optional: the public web address of AccessAll (no trailing slash). The phone
# apps use it for links meant for other people, e.g. the report link inside a
# letter to school staff. Without it, those letters simply omit the link.
# EXPO_PUBLIC_WEB_URL=https://accessall.example.org
